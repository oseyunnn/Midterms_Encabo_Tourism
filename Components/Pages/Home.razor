@page "/"
@rendermode InteractiveServer

<PageTitle>QAZAQ - Kazakhstan Tourism Paradise</PageTitle>

<section class="relative bg-[#edf5fb] px-3 pb-8 pt-3 sm:px-5 lg:px-8">
    <div class="mx-auto max-w-[1280px]">
        <div class="editorial-shell">
            <div class="relative h-[560px] overflow-hidden sm:h-[620px] lg:h-[700px]">
                <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=1800&q=85"
                     alt="Kazakhstan mountain lake"
                     class="h-full w-full object-cover brightness-[0.82]" />
                <div class="absolute inset-0 bg-gradient-to-r from-[#0d2240]/75 via-[#0d2240]/20 to-[#0d2240]/10"></div>

                <div class="absolute inset-0 z-10 flex flex-col justify-center px-6 sm:px-8 lg:px-12">
                    <div class="mx-auto w-full max-w-5xl">
                        <div class="max-w-2xl text-white">
                            <span class="inline-flex items-center gap-2 rounded-full border border-[#f7d89c]/50 bg-black/20 px-4 py-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-[#f7d89c] backdrop-blur-md shadow-sm">
                                <span class="h-2 w-2 rounded-full bg-[#d5a76d] animate-pulse"></span>
                                Central Asia's Grand Frontier
                            </span>
                            <h1 class="mt-5 font-display text-5xl leading-[0.95] tracking-[-0.04em] text-[#f9d79a] sm:text-6xl lg:text-[7rem]">
                                Nature Is Paradise
                            </h1>
                            <p class="mt-4 max-w-xl text-base text-stone-100/90 sm:text-lg">
                                Untouched mountain sanctuaries, crystal turquoise lakes, and the timeless warmth of the Great Steppe.
                            </p>
                            <div class="mt-8 flex flex-wrap items-center gap-4">
                                <a href="/spots" class="btn-gold px-7 py-3 text-[10px]">
                                    Explore Destinations
                                </a>
                                <a href="/booking" class="btn-outline text-[10px] px-6 py-3">
                                    Book Our Paradise
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="border-t border-[#e7ddcf] bg-[#f7f3ee] py-6">
                <div class="mx-auto max-w-6xl px-4 sm:px-6">
                    <div class="grid grid-cols-2 gap-4 text-center text-[#1b2330] sm:grid-cols-5">
                        <a href="/spots" class="group flex flex-col items-center gap-2.5 rounded-2xl py-3 transition-transform hover:-translate-y-1">
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-[#e7ddcf] bg-white text-[#c9964a] shadow-sm"><svg viewBox="0 0 24 24" class="h-5 w-5 stroke-current fill-none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20L10 8L14 15L17 11L20 20H4Z" /><path d="M8.5 11L10 8L11.5 11" /></svg></span>
                            <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#1b2330]">Alpine Peaks</span>
                        </a>
                        <a href="/spots" class="group flex flex-col items-center gap-2.5 rounded-2xl py-3 transition-transform hover:-translate-y-1">
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-[#e7ddcf] bg-white text-[#1b2330] shadow-sm"><svg viewBox="0 0 24 24" class="h-5 w-5 stroke-current fill-none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" /></svg></span>
                            <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#1b2330]">Mirror Lakes</span>
                        </a>
                        <a href="/spots" class="group flex flex-col items-center gap-2.5 rounded-2xl py-3 transition-transform hover:-translate-y-1">
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-[#e7ddcf] bg-white text-[#c9964a] shadow-sm"><svg viewBox="0 0 24 24" class="h-5 w-5 stroke-current fill-none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V11l4 3 3-5 4 4 3-7v15" /><circle cx="17" cy="5" r="2" /></svg></span>
                            <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#1b2330]">Desert Canyons</span>
                        </a>
                        <a href="/about" class="group flex flex-col items-center gap-2.5 rounded-2xl py-3 transition-transform hover:-translate-y-1">
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-[#e7ddcf] bg-white text-[#c9964a] shadow-sm"><svg viewBox="0 0 24 24" class="h-5 w-5 stroke-current fill-none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v3M4 12c0-3.5 3.5-6 8-6s8 2.5 8 6v8H4v-8z" /><path d="M10 20v-5a2 2 0 0 1 4 0v5" /></svg></span>
                            <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#1b2330]">Yurt Stays</span>
                        </a>
                        <a href="/spots" class="group flex flex-col items-center gap-2.5 rounded-2xl py-3 transition-transform hover:-translate-y-1">
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl border border-[#e7ddcf] bg-white text-[#1b2330] shadow-sm"><svg viewBox="0 0 24 24" class="h-5 w-5 stroke-current fill-none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V10a8 8 0 0 1 16 0v11" /><path d="M9 21v-6a3 3 0 0 1 6 0v6" /><path d="M12 3v3" /></svg></span>
                            <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#1b2330]">Silk Road</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-[#f5f7f4] py-20">
    <div class="mx-auto max-w-7xl px-6">
        <div class="grid items-start gap-10 lg:grid-cols-12">
            <div class="lg:col-span-4 space-y-4">
                <span class="badge-azure">Seasonal Expeditions</span>
                <h2 class="font-display text-3xl sm:text-4xl text-[#1b2330] leading-tight">
                    Explore the Steppe Seasons
                </h2>
                <p class="text-sm leading-relaxed text-[#4b4f54]">
                    Curated journeys to help you experience Kazakhstan's dramatic landscapes in every phase of the sun and stars.
                </p>
                <div class="pt-2">
                    <a href="/spots" class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#1b2330] hover:text-[#0d1721]">
                        View Tour Catalog →
                    </a>
                </div>
            </div>

            <div class="lg:col-span-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                <div class="group relative overflow-hidden rounded-[26px] shadow-sm hover:shadow-xl transition-all">
                    <img src="https://images.unsplash.com/photo-1518457607834-6e8d80c183c5?auto=format&fit=crop&w=600&q=80" class="h-80 w-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Spring" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-black/15"></div>
                    <div class="absolute bottom-4 left-4 right-4 text-white">
                        <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#f3d7a2]">Spring</span>
                        <h3 class="font-display text-xl">Awakening</h3>
                    </div>
                </div>
                <div class="group relative overflow-hidden rounded-[26px] shadow-sm hover:shadow-xl transition-all">
                    <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=600&q=80" class="h-80 w-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Summer" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-black/15"></div>
                    <div class="absolute bottom-4 left-4 right-4 text-white">
                        <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#f5e1b6]">Summer</span>
                        <h3 class="font-display text-xl">Turquoise Waters</h3>
                    </div>
                </div>
                <div class="group relative overflow-hidden rounded-[26px] shadow-sm hover:shadow-xl transition-all">
                    <img src="https://images.unsplash.com/photo-1509316975850-ff9c5deb0cd9?auto=format&fit=crop&w=600&q=80" class="h-80 w-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Autumn" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-black/15"></div>
                    <div class="absolute bottom-4 left-4 right-4 text-white">
                        <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#f3d7a2]">Autumn</span>
                        <h3 class="font-display text-xl">Golden Canyons</h3>
                    </div>
                </div>
                <div class="group relative overflow-hidden rounded-[26px] shadow-sm hover:shadow-xl transition-all">
                    <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=600&q=80" class="h-80 w-full object-cover group-hover:scale-105 transition-transform duration-500" alt="Winter" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-transparent to-black/15"></div>
                    <div class="absolute bottom-4 left-4 right-4 text-white">
                        <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-[#f2e7d8]">Winter</span>
                        <h3 class="font-display text-xl">Alpine Serenity</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-[#0e243d] py-20 text-white">
    <div class="mx-auto max-w-7xl px-6">
        <div class="grid items-start gap-10 lg:grid-cols-12">
            <div class="lg:col-span-4 space-y-4">
                <span class="badge-gold">Nomadic Philosophy</span>
                <h2 class="font-display text-3xl sm:text-4xl text-[#f0c77d] leading-tight">
                    Rooted in the Great Steppe
                </h2>
                <p class="text-sm leading-relaxed text-[#efe7df]">
                    Centuries of harmonious nomadic living, celestial yurt cosmology, and the sacred code of Dastarkhan that honors every visitor as a gift from the sky.
                </p>
                <div class="pt-2">
                    <a href="/about" class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-[#f2d9a7] hover:text-white">
                        Read Cultural Story →
                    </a>
                </div>
            </div>

            <div class="lg:col-span-8 grid gap-6 sm:grid-cols-3">
                <div class="card-dark group p-5">
                    <div class="overflow-hidden rounded-2xl border border-[#d7c7ae]/40">
                        <img src="https://images.unsplash.com/photo-1533240332313-0db49b459ad6?auto=format&fit=crop&w=600&q=80" alt="Kazakh Yurt" class="h-44 w-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <h3 class="mt-4 font-display text-lg font-bold text-[#f0c77d]">The Portable Yurt</h3>
                    <p class="mt-1 text-xs text-[#e2eaf4]/80 leading-relaxed">The felt home with the Shanyrak dome connecting earth and the celestial sky.</p>
                </div>
                <div class="card-dark group p-5">
                    <div class="overflow-hidden rounded-2xl border border-[#d7c7ae]/40">
                        <img src="https://images.unsplash.com/photo-1584551246679-0daf3d275d0f?auto=format&fit=crop&w=600&q=80" alt="Silk Road architecture" class="h-44 w-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <h3 class="mt-4 font-display text-lg font-bold text-[#f0c77d]">Silk Road Carvings</h3>
                    <p class="mt-1 text-xs text-[#e2eaf4]/80 leading-relaxed">Ancient cobalt tilework and bronze cauldrons preserved across centuries in Turkistan.</p>
                </div>
                <div class="card-dark group p-5">
                    <div class="overflow-hidden rounded-2xl border border-[#d7c7ae]/40">
                        <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=600&q=80" alt="Eagle falconry" class="h-44 w-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <h3 class="mt-4 font-display text-lg font-bold text-[#f0c77d]">Berkutchi Falconry</h3>
                    <p class="mt-1 text-xs text-[#e2eaf4]/80 leading-relaxed">A 4,000-year partnership with majestic golden eagles across the open steppe.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="bg-[#f6f6f1] py-20">
    <div class="mx-auto max-w-7xl px-6">
        <div class="flex items-end justify-between border-b border-sky-100 pb-6">
            <div>
                <span class="badge-azure">Iconic Destinations</span>
                <h2 class="mt-2 font-display text-3xl sm:text-4xl text-sky-950">Featured Kazakhstan Spots</h2>
            </div>
            <a href="/spots" class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.2em] text-sky-700 hover:text-sky-900">
                View All Destinations →
            </a>
        </div>

        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var spot in SampleData.Spots.Take(3))
            {
                <article class="card flex flex-col justify-between group p-5">
                    <div>
                        <div class="relative overflow-hidden rounded-[22px] border border-sky-100">
                            <img src="@spot.ImageUrl" alt="@spot.Name" class="h-56 w-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            <span class="absolute left-3 top-3 badge-glass bg-black/20">@spot.GetFormattedRegion()</span>
                            @if (spot.IsUnescoHeritage)
                            {
                                <span class="absolute right-3 top-3 badge-gold">UNESCO</span>
                            }
                        </div>

                        <div class="mt-4">
                            <div class="flex items-center justify-between text-xs text-sky-700/75">
                                <span>@spot.DurationDays @(spot.DurationDays == 1 ? "day trip" : "days tour")</span>
                                <span class="font-bold text-[#c67d43] flex items-center gap-1">
                                    <svg class="h-3.5 w-3.5 fill-current stroke-none" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                                    @spot.Rating.ToString("0.0")
                                </span>
                            </div>
                            <h3 class="mt-2 font-display text-xl font-bold text-sky-950">@spot.Name</h3>
                            <p class="text-xs font-serif italic text-[#ba7643]">@spot.KazakhName</p>
                            <p class="mt-2 text-xs leading-relaxed text-sky-800/70 line-clamp-2">@spot.ShortDescription</p>
                        </div>
                    </div>

                    <div class="mt-6 flex items-center justify-between border-t border-sky-100 pt-4">
                        <div>
                            <span class="block text-[10px] uppercase tracking-[0.2em] text-sky-700 font-bold">Rates From</span>
                            <span class="text-xl font-display font-bold text-sky-950">$@spot.BasePriceUsd <span class="text-xs font-sans font-normal text-sky-700/70">/ person</span></span>
                        </div>
                        <a href="@($"/booking?spotId={spot.Id}")" class="btn-gold text-[11px] py-2 px-5">Book Spot</a>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="border-t border-sky-200 bg-[#0d2240] py-14 text-white">
    <div class="mx-auto max-w-7xl px-6">
        <div class="grid items-center gap-10 md:grid-cols-12">
            <div class="md:col-span-5 space-y-2">
                <span class="text-[11px] font-bold uppercase tracking-[0.22em] text-[#f3d7a2]">Traverse With Confidence</span>
                <h3 class="font-display text-2xl sm:text-3xl font-normal text-white">Central Asia's Most Welcoming Frontier</h3>
                <p class="text-xs text-sky-100/75 leading-relaxed">Licensed eco-tourism, authentic regional yurt hospitality, and seamless visa-free access.</p>
            </div>

            <div class="md:col-span-7 grid grid-cols-3 gap-6 border-l border-sky-100/20 pl-6 text-center">
                <div>
                    <span class="block font-display text-3xl sm:text-4xl font-bold text-[#f3d7a2]">+22%</span>
                    <span class="mt-1 block text-xs uppercase tracking-[0.18em] text-sky-100/80">YoY Eco-Growth</span>
                </div>
                <div>
                    <span class="block font-display text-3xl sm:text-4xl font-bold text-sky-300">5 Sites</span>
                    <span class="mt-1 block text-xs uppercase tracking-[0.18em] text-sky-100/80">UNESCO Listed</span>
                </div>
                <div>
                    <span class="block font-display text-3xl sm:text-4xl font-bold text-white">80+</span>
                    <span class="mt-1 block text-xs uppercase tracking-[0.18em] text-sky-100/80">Visa-Free Nations</span>
                </div>
            </div>
        </div>
    </div>
</section>

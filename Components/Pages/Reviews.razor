@page "/reviews"
@rendermode InteractiveServer

<PageTitle>Reviews - Past Tourists in Kazakhstan</PageTitle>

<!-- Hero Section in Summit-Style Midnight Azure -->
<section class="border-b border-line-dark bg-[#081c34] text-white py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div class="max-w-2xl">
                <span class="badge-gold">✦ Verified Guest Stories ✦</span>
                <h1 class="mt-4 font-display text-4xl sm:text-5xl font-normal text-[#f7f1e8] leading-tight">
                    Traveler Journals & Experiences
                </h1>
                <p class="mt-3 text-base text-[#efe7df] font-light">
                    Real impressions and memories from explorers who traversed the turquoise alpine lakes, desert canyons, and ancient Silk Road caravans of Kazakhstan.
                </p>
            </div>

            <!-- Submit Review Action -->
            <button class="btn-gold shrink-0 text-xs py-3 px-6 shadow-md" @onclick="() => showModal = true">
                + Share Your Experience
            </button>
        </div>

        <!-- Metric Rating Banner -->
        <div class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4 border-t border-line-dark pt-8">
            <div class="rounded-2xl border border-line-dark bg-navy-card p-4">
                <span class="block text-[#f0c77d] font-display text-3xl font-bold">4.9 / 5.0</span>
                <span class="text-xs text-stone-300">Average Guest Rating</span>
            </div>
            <div class="rounded-2xl border border-line-dark bg-navy-card p-4">
                <span class="block text-[#f7f1e8] font-display text-3xl font-bold">98.4%</span>
                <span class="text-xs text-stone-300">Would Recommend</span>
            </div>
            <div class="rounded-2xl border border-line-dark bg-navy-card p-4">
                <span class="block text-[#f0c77d] font-display text-3xl font-bold">1,820+</span>
                <span class="text-xs text-stone-300">Verified Expeditions</span>
            </div>
            <div class="rounded-2xl border border-line-dark bg-navy-card p-4">
                <span class="block text-[#f7f1e8] font-display text-3xl font-bold">40+</span>
                <span class="text-xs text-stone-300">Countries Represented</span>
            </div>
        </div>
    </div>
</section>

<!-- Filter & Review Cards Section -->
<section class="py-14 bg-paper min-h-[600px]">
    <div class="mx-auto max-w-7xl px-6">
        <!-- Interactive Filter Bar -->
        <div class="rounded-3xl border border-sky-100 bg-white p-5 shadow-xs flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex-1 max-w-md">
                <input type="text" class="field" placeholder="Search by destination or traveler..." 
                       @bind="searchQuery" @bind:event="oninput" />
            </div>

            <div class="flex items-center gap-2">
                <button class="@(ratingFilter == 0 ? "btn text-xs py-2 px-4" : "btn-outline-dark text-xs py-2 px-4")" 
                        @onclick="() => ratingFilter = 0">
                    All Reviews
                </button>
                <button class="@(ratingFilter == 5 ? "btn text-xs py-2 px-4" : "btn-outline-dark text-xs py-2 px-4")" 
                        @onclick="() => ratingFilter = 5">
                    5 Stars Only
                </button>
                <button class="@(ratingFilter == 4 ? "btn text-xs py-2 px-4" : "btn-outline-dark text-xs py-2 px-4")" 
                        @onclick="() => ratingFilter = 4">
                    4 Stars
                </button>
            </div>
        </div>

        <!-- Reviews Grid -->
        <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var review in FilteredReviews)
            {
                <article class="card flex flex-col justify-between group p-6">
                    <div>
                        <!-- Header with Stars & Badge -->
                        <div class="flex items-center justify-between border-b border-sky-100 pb-3">
                            <div class="flex items-center gap-1 text-amber-400">
                                @for (int i = 0; i < review.Rating; i++)
                                {
                                    <svg class="h-3.5 w-3.5 fill-amber-400 stroke-none" viewBox="0 0 24 24">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                    </svg>
                                }
                            </div>
                            <span class="badge-azure text-[10px]">@review.Country</span>
                        </div>

                        <!-- Destination Tag -->
                        <div class="mt-3">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-sky-800">Destination:</span>
                            <span class="ml-1 text-xs font-semibold text-stone-900">@review.DestinationName</span>
                        </div>

                        <!-- Review Text -->
                        <h3 class="mt-2 font-display text-lg font-bold text-sky-950 leading-snug">@review.Title</h3>
                        <p class="mt-2 text-xs text-stone-600 leading-relaxed font-normal">"@review.Comment"</p>
                    </div>

                    <!-- Footer with Author & Helpful Button (Clean SVG Icon, No Emojis) -->
                    <div class="mt-6 border-t border-sky-100 pt-4 flex items-center justify-between">
                        <div>
                            <span class="block text-xs font-bold text-sky-950">@review.AuthorName</span>
                            <span class="block text-[10px] text-stone-400">@review.TravelMonth • Verified Guest</span>
                        </div>

                        <button class="flex items-center gap-1.5 rounded-full border border-sky-200 bg-sky-50/50 px-3 py-1 text-[11px] font-bold text-sky-800 hover:border-sky-400 hover:bg-sky-100 transition-colors"
                                @onclick="() => VoteHelpful(review)"
                                title="Vote review as helpful">
                            <svg viewBox="0 0 24 24" class="h-3.5 w-3.5 stroke-sky-700 fill-none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3" />
                            </svg>
                            <span>@(review.HelpfulVotes)</span>
                        </button>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<!-- Submit Review Modal -->
@if (showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 backdrop-blur-md"
         @onclick="() => showModal = false" role="dialog" aria-modal="true">
        <div class="relative w-full max-w-lg rounded-3xl border border-sky-100 bg-white p-6 sm:p-8 shadow-2xl"
             @onclick:stopPropagation="true">
            <button class="absolute top-5 right-5 text-stone-400 hover:text-sky-950 text-xl font-bold" 
                    @onclick="() => showModal = false">✕</button>

            <span class="badge-gold">✦ Traveler Feedback ✦</span>
            <h2 class="mt-2 font-display text-2xl font-bold text-sky-950">Share Your Kazakhstan Journey</h2>
            <p class="mt-1 text-xs text-stone-500">Your insights assist future explorers embarking on their steppe expeditions.</p>

            <div class="mt-6 space-y-4 text-xs">
                <div>
                    <label class="field-label">Your Name</label>
                    <input type="text" class="field" placeholder="e.g. Sarah Jenkins" @bind="newReviewAuthor" />
                </div>
                <div>
                    <label class="field-label">Home Country</label>
                    <input type="text" class="field" placeholder="e.g. Germany" @bind="newReviewCountry" />
                </div>
                <div>
                    <label class="field-label">Destination Visited</label>
                    <select class="field" @bind="newReviewDestination">
                        @foreach (var spot in SampleData.Spots)
                        {
                            <option value="@spot.Name">@spot.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="field-label">Review Headline</label>
                    <input type="text" class="field" placeholder="e.g. Pure magic in the Tien Shan..." @bind="newReviewTitle" />
                </div>
                <div>
                    <label class="field-label">Your Experience Notes</label>
                    <textarea class="field" rows="3" placeholder="Share your experience with local guides, meals, and landscapes..." @bind="newReviewComment"></textarea>
                </div>

                <div class="pt-2">
                    <button class="btn-gold w-full py-3" @onclick="SubmitNewReview">
                        Post Verified Review
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string searchQuery = "";
    private int ratingFilter = 0;
    private bool showModal = false;

    private List<TouristReview> reviews = SampleData.Reviews;

    private string newReviewAuthor = "";
    private string newReviewCountry = "";
    private string newReviewDestination = "Kaindy Lake Submerged Forest";
    private string newReviewTitle = "";
    private string newReviewComment = "";

    private IEnumerable<TouristReview> FilteredReviews => reviews.Where(r => 
        (ratingFilter == 0 || r.Rating == ratingFilter) &&
        (string.IsNullOrWhiteSpace(searchQuery) ||
         r.AuthorName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
         r.DestinationName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
         r.Country.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
         r.Comment.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)));

    private void VoteHelpful(TouristReview review)
    {
        if (!review.HasVotedHelpful)
        {
            review.HelpfulVotes++;
            review.HasVotedHelpful = true;
        }
    }

    private void SubmitNewReview()
    {
        if (!string.IsNullOrWhiteSpace(newReviewAuthor) && !string.IsNullOrWhiteSpace(newReviewComment))
        {
            reviews.Insert(0, new TouristReview
            {
                Id = reviews.Count + 1,
                AuthorName = newReviewAuthor,
                Country = string.IsNullOrWhiteSpace(newReviewCountry) ? "International Traveler" : newReviewCountry,
                DestinationName = newReviewDestination,
                Rating = 5,
                TravelMonth = DateTime.Now.ToString("MMMM yyyy"),
                Title = string.IsNullOrWhiteSpace(newReviewTitle) ? "Unforgettable Expedition" : newReviewTitle,
                Comment = newReviewComment,
                HelpfulVotes = 1,
                IsVerifiedGuest = true
            });

            newReviewAuthor = "";
            newReviewCountry = "";
            newReviewTitle = "";
            newReviewComment = "";
            showModal = false;
        }
    }
}

@page "/spots"
@rendermode InteractiveServer

<PageTitle>Destinations - Kazakhstan Paradise Explorer</PageTitle>

<!-- Header -->
<section class="border-b border-sky-100 bg-gradient-to-b from-sky-50 to-white py-12">
    <div class="mx-auto max-w-7xl px-6">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
            <div>
                <span class="badge-azure">Central Asia Portfolio</span>
                <h1 class="mt-3 font-display text-4xl sm:text-5xl font-normal text-sky-950">
                    Kazakhstan Destinations
                </h1>
                <p class="mt-2 text-sm text-stone-600 max-w-xl">
                    Traverse subterranean canyon labyrinths, turquoise alpine mirrors, and 14th-century Silk Road sanctuaries.
                </p>
            </div>

            <!-- Saved Wishlist Pill Counter -->
            <div class="flex items-center gap-3 rounded-full border border-amber-200 bg-amber-50/90 px-5 py-2.5 shadow-xs">
                <svg viewBox="0 0 24 24" class="h-4 w-4 fill-amber-500 text-amber-500">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                </svg>
                <div class="text-xs">
                    <span class="text-stone-600 font-semibold">Saved Wishlist:</span>
                    <strong class="ml-1 text-sky-950 font-bold">@savedCount spot@(savedCount == 1 ? "" : "s")</strong>
                </div>
            </div>
        </div>

        <!-- Sleek Floating Filter Bar -->
        <div class="mt-10 rounded-3xl border border-sky-100 bg-white p-6 shadow-sm">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <!-- Search -->
                <div>
                    <label for="search" class="field-label">Search</label>
                    <div class="relative">
                        <input id="search" type="text" class="field pl-10" placeholder="Kaindy, Charyn, Turkistan..." 
                               @bind="searchQuery" @bind:event="oninput" />
                        <svg class="absolute left-3.5 top-3.5 h-4 w-4 text-sky-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <circle cx="11" cy="11" r="7" stroke-width="2" />
                            <path stroke-linecap="round" stroke-width="2" d="M21 21l-4.35-4.35" />
                        </svg>
                    </div>
                </div>

                <!-- Region Filter -->
                <div>
                    <label for="region" class="field-label">Region</label>
                    <select id="region" class="field" @bind="selectedRegion">
                        <option value="">All Kazakhstan Regions</option>
                        @foreach (var r in Enum.GetValues<Region>())
                        {
                            <option value="@r">@GetRegionDisplayName(r)</option>
                        }
                    </select>
                </div>

                <!-- Category Filter -->
                <div>
                    <label for="cat" class="field-label">Category</label>
                    <select id="cat" class="field" @bind="selectedCategory">
                        <option value="">All Categories</option>
                        @foreach (var c in Enum.GetValues<SpotCategory>())
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>

                <!-- Sort Order -->
                <div>
                    <label for="sort" class="field-label">Sort Order</label>
                    <select id="sort" class="field" @bind="selectedSort">
                        <option value="popular">Most Popular</option>
                        <option value="price-asc">Price: Low to High</option>
                        <option value="price-desc">Price: High to Low</option>
                        <option value="rating">Highest Rated</option>
                        <option value="altitude">Highest Altitude</option>
                    </select>
                </div>
            </div>

            <!-- Secondary Quick Filters -->
            <div class="mt-5 flex flex-wrap items-center justify-between gap-4 border-t border-sky-100 pt-4 text-xs text-stone-600">
                <div class="flex items-center gap-6">
                    <label class="flex items-center gap-2 cursor-pointer font-semibold text-stone-700">
                        <input type="checkbox" @bind="unescoOnly" class="h-4 w-4 rounded-md border-sky-200 text-sky-600 focus:ring-sky-500" />
                        <span>UNESCO Sites Only</span>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer font-semibold text-stone-700">
                        <input type="checkbox" @bind="wishlistOnly" class="h-4 w-4 rounded-md border-sky-200 text-sky-600 focus:ring-sky-500" />
                        <span>Saved Only (@savedCount)</span>
                    </label>
                </div>

                <div class="flex items-center gap-3">
                    <span>Showing <strong>@FilteredSpots.Count()</strong> of @spots.Count destinations</span>
                    @if (HasActiveFilters)
                    {
                        <button class="text-sky-600 font-bold hover:underline" @onclick="ResetFilters">Reset Filters</button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Spots Showcase Grid -->
<section class="mx-auto max-w-7xl px-6 py-14">
    @if (!FilteredSpots.Any())
    {
        <div class="card text-center py-20 border-dashed rounded-3xl">
            <p class="font-display text-2xl text-sky-950">No destinations found matching your criteria</p>
            <p class="mt-2 text-sm text-stone-500">Try clearing your search query or broadening the regional filter.</p>
            <button class="btn mt-6" @onclick="ResetFilters">Reset All Filters</button>
        </div>
    }
    else
    {
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var spot in FilteredSpots)
            {
                <article class="card flex flex-col justify-between group p-5">
                    <div>
                        <!-- Destination Imagery with Badges -->
                        <div class="relative overflow-hidden rounded-2xl border border-sky-100">
                            <img src="@spot.ImageUrl" alt="@spot.Name" 
                                 class="h-60 w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                            
                            <div class="absolute top-3 left-3 flex flex-col gap-1 items-start">
                                <span class="badge-glass text-[10px]">@spot.GetFormattedRegion()</span>
                                @if (spot.IsUnescoHeritage)
                                {
                                    <span class="badge-gold text-[10px]">UNESCO</span>
                                }
                            </div>

                            <!-- Wishlist Toggle (Inline SVG, No Emojis) -->
                            <button class="absolute top-3 right-3 h-8 w-8 rounded-full bg-white/95 flex items-center justify-center shadow hover:bg-white transition-colors"
                                    @onclick="() => ToggleSave(spot)"
                                    title="@(spot.IsSaved ? "Remove from wishlist" : "Save to wishlist")"
                                    aria-label="Toggle wishlist">
                                @if (spot.IsSaved)
                                {
                                    <svg viewBox="0 0 24 24" class="h-4 w-4 fill-amber-500 text-amber-500">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                    </svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-stone-400 fill-none" stroke-width="2">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                    </svg>
                                }
                            </button>

                            <div class="absolute bottom-3 right-3 rounded-full bg-black/60 px-3 py-0.5 text-[10px] text-white backdrop-blur-md">
                                @spot.DurationDays @(spot.DurationDays == 1 ? "Day Trip" : "Days Expedition")
                            </div>
                        </div>

                        <!-- Content Body -->
                        <div class="mt-4">
                            <div class="flex items-center justify-between text-xs text-stone-500">
                                <span class="badge text-[10px]">@spot.Category</span>
                                <span class="font-bold text-amber-600 flex items-center gap-1">
                                    <svg class="h-3.5 w-3.5 fill-amber-400 stroke-none" viewBox="0 0 24 24">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                    </svg>
                                    @spot.Rating.ToString("0.0") (@spot.ReviewCount)
                                </span>
                            </div>

                            <h2 class="mt-2 font-display text-xl font-bold text-sky-950 leading-snug">@spot.Name</h2>
                            <p class="text-xs font-serif italic text-amber-700">@spot.KazakhName</p>
                            <p class="mt-2 text-xs text-stone-600 leading-relaxed line-clamp-3">@spot.ShortDescription</p>

                            <!-- Mini Specs -->
                            <div class="mt-4 grid grid-cols-2 gap-2 border-t border-sky-100 pt-3 text-[11px] text-stone-600">
                                <div>
                                    <span class="block text-stone-400 uppercase text-[9px] font-bold tracking-wider">Altitude</span>
                                    <span class="font-semibold text-sky-950">@(spot.AltitudeMeters > 0 ? $"{spot.AltitudeMeters} m" : "Sea Level")</span>
                                </div>
                                <div>
                                    <span class="block text-stone-400 uppercase text-[9px] font-bold tracking-wider">Difficulty</span>
                                    <span class="font-semibold text-sky-950">@spot.Difficulty</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Footer & Quick Actions -->
                    <div class="mt-6 flex items-center justify-between border-t border-sky-100 pt-4">
                        <div>
                            <span class="block text-[10px] uppercase tracking-wider text-stone-500 font-bold">Rates From</span>
                            <span class="text-xl font-display font-bold text-sky-950">$@spot.BasePriceUsd <span class="text-xs font-sans font-normal text-stone-500">/ person</span></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <button class="btn-outline-dark text-[11px] py-2 px-3.5" @onclick="() => OpenModal(spot)">
                                Quick View
                            </button>
                            <a href="@($"/booking?spotId={spot.Id}")" class="btn-gold text-[11px] py-2 px-4 shadow-sm">
                                Book Spot
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<!-- Quick View & Dynamic OOP Pricing Calculator Modal -->
@if (activeModalSpot is not null)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 p-4 backdrop-blur-md"
         @onclick="CloseModal" role="dialog" aria-modal="true">
        <div class="relative max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-3xl border border-sky-100 bg-white p-6 sm:p-8 shadow-2xl"
             @onclick:stopPropagation="true">
            
            <button class="absolute top-5 right-5 flex h-9 w-9 items-center justify-center rounded-full border border-sky-200 text-stone-400 hover:text-sky-950 hover:border-sky-500 transition-colors" 
                    @onclick="CloseModal" aria-label="Close modal">✕</button>

            <div class="border-b border-sky-100 pb-4 pr-10">
                <span class="badge-azure">@activeModalSpot.GetFormattedRegion()</span>
                @if (activeModalSpot.IsUnescoHeritage)
                {
                    <span class="badge-gold ml-2">UNESCO World Heritage</span>
                }
                <h3 class="mt-2 text-2xl sm:text-3xl font-display font-bold text-sky-950">@activeModalSpot.Name</h3>
                <p class="text-sm font-serif italic text-amber-700">@activeModalSpot.KazakhName</p>
            </div>

            <div class="mt-4 overflow-hidden rounded-2xl border border-sky-100">
                <img src="@activeModalSpot.ImageUrl" alt="@activeModalSpot.Name" 
                     class="h-64 w-full object-cover" />
            </div>

            <div class="mt-4">
                <h4 class="text-[11px] font-bold uppercase tracking-wider text-sky-800">Overview</h4>
                <p class="mt-1 text-sm leading-relaxed text-stone-600 font-normal">@activeModalSpot.FullDescription</p>
            </div>

            <!-- Expedition Highlights -->
            <div class="mt-5 border-t border-sky-100 pt-4">
                <h4 class="text-[11px] font-bold uppercase tracking-wider text-sky-800">Tour Highlights</h4>
                <ul class="mt-2 grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-sky-950">
                    @foreach (var highlight in activeModalSpot.Highlights)
                    {
                        <li class="flex items-center gap-2 rounded-xl bg-sky-50/70 p-2.5">
                            <span class="text-amber-500 font-bold">✦</span>
                            <span>@highlight</span>
                        </li>
                    }
                </ul>
            </div>

            <!-- OOP Polymorphic Price Calculator Widget -->
            <div class="mt-6 rounded-2xl border border-sky-200 bg-sky-50/50 p-5">
                <div class="flex items-center justify-between">
                    <h4 class="text-xs font-bold uppercase tracking-wider text-sky-950">Package Estimator (OOP Polymorphic Method)</h4>
                    <span class="text-xs text-stone-500">Best Season: @activeModalSpot.BestSeason</span>
                </div>

                <div class="mt-4 grid gap-4 sm:grid-cols-2">
                    <div>
                        <label class="block text-xs font-semibold text-stone-700 mb-1.5">Traveler Count</label>
                        <div class="flex items-center gap-2">
                            <button class="btn-outline-dark h-9 w-9 p-0 flex items-center justify-center font-bold text-sm"
                                    @onclick="() => modalTravelers = Math.Max(1, modalTravelers - 1)">-</button>
                            <span class="font-bold text-sm w-8 text-center text-sky-950">@modalTravelers</span>
                            <button class="btn-outline-dark h-9 w-9 p-0 flex items-center justify-center font-bold text-sm"
                                    @onclick="() => modalTravelers = Math.Min(15, modalTravelers + 1)">+</button>
                            @if (modalTravelers >= 4)
                            {
                                <span class="badge-gold text-[10px]">12% Group Discount!</span>
                            }
                        </div>
                    </div>

                    <div class="flex items-center">
                        <label class="flex items-center gap-2 cursor-pointer text-xs font-medium text-stone-800">
                            <input type="checkbox" @bind="modalIncludeGuide" class="h-4 w-4 rounded-md border-sky-300 text-sky-600" />
                            <span>Add Nomadic Guide ($65/day)</span>
                        </label>
                    </div>
                </div>

                <div class="mt-5 flex items-center justify-between border-t border-sky-200/60 pt-4">
                    <div>
                        <span class="text-[11px] uppercase tracking-wider text-stone-500 font-semibold">Total Estimate:</span>
                        <div class="text-2xl font-display font-bold text-sky-700">
                            $@activeModalSpot.CalculatePackageCost(modalTravelers, modalIncludeGuide)
                            <span class="text-xs font-sans font-normal text-stone-500">USD</span>
                        </div>
                    </div>
                    <a href="@($"/booking?spotId={activeModalSpot.Id}")" class="btn-gold text-xs py-2.5 px-6 shadow-sm">
                        Book Destination
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private string searchQuery = "";
    private string selectedRegion = "";
    private string selectedCategory = "";
    private string selectedSort = "popular";
    private bool unescoOnly;
    private bool wishlistOnly;

    private List<TouristSpot> spots = SampleData.Spots;
    private TouristSpot? activeModalSpot;
    private int modalTravelers = 2;
    private bool modalIncludeGuide = true;

    private int savedCount => spots.Count(s => s.IsSaved);

    private bool HasActiveFilters => 
        !string.IsNullOrWhiteSpace(searchQuery) ||
        !string.IsNullOrEmpty(selectedRegion) ||
        !string.IsNullOrEmpty(selectedCategory) ||
        unescoOnly ||
        wishlistOnly;

    private IEnumerable<TouristSpot> FilteredSpots
    {
        get
        {
            var query = spots.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                query = query.Where(s => 
                    s.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.KazakhName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    s.ShortDescription.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrEmpty(selectedRegion) && Enum.TryParse<Region>(selectedRegion, out var r))
            {
                query = query.Where(s => s.Region == r);
            }

            if (!string.IsNullOrEmpty(selectedCategory) && Enum.TryParse<SpotCategory>(selectedCategory, out var c))
            {
                query = query.Where(s => s.Category == c);
            }

            if (unescoOnly)
            {
                query = query.Where(s => s.IsUnescoHeritage);
            }

            if (wishlistOnly)
            {
                query = query.Where(s => s.IsSaved);
            }

            query = selectedSort switch
            {
                "price-asc" => query.OrderBy(s => s.BasePriceUsd),
                "price-desc" => query.OrderByDescending(s => s.BasePriceUsd),
                "rating" => query.OrderByDescending(s => s.Rating),
                "altitude" => query.OrderByDescending(s => s.AltitudeMeters),
                _ => query.OrderByDescending(s => s.IsPopular).ThenByDescending(s => s.Rating)
            };

            return query;
        }
    }

    private void ToggleSave(TouristSpot spot)
    {
        spot.IsSaved = !spot.IsSaved;
    }

    private void OpenModal(TouristSpot spot)
    {
        activeModalSpot = spot;
        modalTravelers = 2;
        modalIncludeGuide = true;
    }

    private void CloseModal()
    {
        activeModalSpot = null;
    }

    private void ResetFilters()
    {
        searchQuery = "";
        selectedRegion = "";
        selectedCategory = "";
        selectedSort = "popular";
        unescoOnly = false;
        wishlistOnly = false;
    }

    private string GetRegionDisplayName(Region region) => region switch
    {
        Region.AlmatyRegion => "Almaty Region",
        Region.Mangystau => "Mangystau",
        Region.Turkistan => "Turkistan",
        Region.AstanaCapital => "Astana Capital",
        Region.EastKazakhstan => "East Kazakhstan",
        _ => region.ToString()
    };
}

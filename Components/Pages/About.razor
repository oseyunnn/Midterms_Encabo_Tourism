@page "/about"
@rendermode InteractiveServer

<PageTitle>About - Kazakhstan Heritage & Nation</PageTitle>

<!-- Hero Section in Summit-Style Midnight Azure -->
<section class="border-b border-line-dark bg-[#081c34] text-white py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
            <span class="badge-gold">✦ Land of the Golden Sun ✦</span>
            <h1 class="mt-4 font-display text-4xl sm:text-6xl font-normal text-white leading-[1.08] tracking-tight">
                Kazakhstan: Soul of the Great Steppe
            </h1>
            <p class="mt-5 text-base sm:text-lg text-[#efe7df] font-light leading-relaxed">
                Spanning five distinct climate zones between the Caspian Sea and the Altai peaks, Kazakhstan is an immense realm where millennia of equestrian nomadism blend seamlessly with modern Eurasian progress.
            </p>
        </div>
    </div>
</section>

<!-- Integrated Nomadic Culture Pillar (Light Azure/White Section) -->
<section class="py-20 bg-paper border-b border-sky-100">
    <div class="mx-auto max-w-7xl px-6">
        <div class="grid items-center gap-12 lg:grid-cols-12">
            <div class="lg:col-span-5 space-y-5">
                <span class="badge-azure">Nomadic Ethos</span>
                <h2 class="font-display text-3xl sm:text-4xl text-[#1b2330] leading-tight">
                    Hospitality as a Sacred Duty
                </h2>
                <p class="text-sm leading-relaxed text-stone-600">
                    Steppe nomad life was shaped by an unbreakable covenant with nature and the eternal blue sky (Tengri). For millennia, strangers crossing the open plain were welcomed into the felt yurt with the highest honor, warm tea, and the rich dishes of the <strong class="text-[#1b2330]">Dastarkhan</strong>.
                </p>

                <div class="space-y-3 pt-2 text-xs text-stone-700">
                    <div class="flex items-start gap-3 rounded-2xl border border-sky-100 bg-white p-4 shadow-xs">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-amber-400/20 text-amber-600">
                            <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-amber-600 fill-none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="5" />
                                <line x1="12" y1="1" x2="12" y2="3" />
                                <line x1="12" y1="21" x2="12" y2="23" />
                                <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
                                <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
                                <line x1="1" y1="12" x2="3" y2="12" />
                                <line x1="21" y1="12" x2="23" y2="12" />
                            </svg>
                        </span>
                        <div>
                            <strong class="text-[#1b2330]">The Shanyrak Crown:</strong> The circular dome of the yurt represents the family hearth and celestial heaven, featured on the national emblem.
                        </div>
                    </div>

                    <div class="flex items-start gap-3 rounded-2xl border border-sky-100 bg-white p-4 shadow-xs">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-amber-400/20 text-amber-600">
                            <svg viewBox="0 0 24 24" class="h-4 w-4 stroke-amber-600 fill-none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 11h16a8 8 0 0 1-16 0z" />
                                <path d="M6 19h12" />
                                <path d="M9 4v3" />
                                <path d="M12 3v4" />
                                <path d="M15 4v3" />
                            </svg>
                        </span>
                        <div>
                            <strong class="text-[#1b2330]">Beshbarmak & Kumis:</strong> Traditional feasts served to honor arriving guests as a sacred blessing from the steppe.
                        </div>
                    </div>
                </div>
            </div>

            <div class="lg:col-span-7 grid gap-6 sm:grid-cols-2">
                @foreach (var item in SampleData.CulturalItems.Take(2))
                {
                    <div class="card p-5 flex flex-col justify-between">
                        <div>
                            <div class="overflow-hidden rounded-2xl border border-sky-100 mb-4">
                                <img src="@item.ImageUrl" alt="@item.Title" class="h-44 w-full object-cover" />
                            </div>
                            <span class="badge text-[10px]">@item.Category</span>
                            <h3 class="mt-2 font-display text-lg font-bold text-[#1b2330]">@item.Title</h3>
                            <p class="text-xs font-serif italic text-[#b57b3d]">@item.KazakhName</p>
                            <p class="mt-2 text-xs text-stone-600 leading-relaxed font-normal">@item.Description</p>
                        </div>
                        <div class="mt-4 border-t border-sky-100 pt-3 text-[11px] font-bold text-[#b57b3d]">
                            ✦ @item.CulturalSignificance
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Geographic Extremes (Dark Azure Section) -->
<section class="py-20 bg-[#081c34] text-white border-b border-line-dark">
    <div class="mx-auto max-w-7xl px-6">
        <div class="text-center max-w-3xl mx-auto mb-14">
            <span class="badge-gold">✦ Topography ✦</span>
            <h2 class="mt-3 font-display text-3xl sm:text-5xl font-normal text-white">
                From Below Sea Level to 7,000-Meter Glaciers
            </h2>
            <p class="mt-3 text-sm text-[#e9e3dc] font-light">
                Kazakhstan is the 9th largest country in the world, holding five distinct biomes and unprecedented natural contrasts.
            </p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div class="card-dark p-6">
                <span class="text-[#f2d9a7] font-bold text-xs uppercase tracking-widest">Mountains</span>
                <h3 class="mt-2 font-display text-2xl font-bold text-white">Tian Shan</h3>
                <p class="mt-2 text-xs text-[#efe7df] leading-relaxed font-light">
                    Glacial mirrors harboring wild apple forests (Malus sieversii) and elusive snow leopards.
                </p>
            </div>

            <div class="card-dark p-6">
                <span class="text-[#f7f1e8] font-bold text-xs uppercase tracking-widest">Grasslands</span>
                <h3 class="mt-2 font-display text-2xl font-bold text-white">The Steppe</h3>
                <p class="mt-2 text-xs text-[#efe7df] leading-relaxed font-light">
                    Endless prairies home to the prehistoric curved-snout Saiga antelope and nomad grazing lands.
                </p>
            </div>

            <div class="card-dark p-6">
                <span class="text-[#d9d2c8] font-bold text-xs uppercase tracking-widest">Forests</span>
                <h3 class="mt-2 font-display text-2xl font-bold text-white">Altai Taiga</h3>
                <p class="mt-2 text-xs text-[#efe7df] leading-relaxed font-light">
                    Siberian cedar trees, maral deer wellness springs, and the pristine Belukha mountain range.
                </p>
            </div>

            <div class="card-dark p-6">
                <span class="text-[#f2d9a7] font-bold text-xs uppercase tracking-widest">Canyon & Basin</span>
                <h3 class="mt-2 font-display text-2xl font-bold text-white">Mangystau</h3>
                <p class="mt-2 text-xs text-[#efe7df] leading-relaxed font-light">
                    The Karagiye depression (-132m) and white chalk spires formed on the ancient Tethys seabed.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Essential Travel Guidance (Light Section) -->
<section class="py-20 bg-paper border-b border-sky-100">
    <div class="mx-auto max-w-7xl px-6">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <span class="badge-azure">Practical Advisory</span>
            <h2 class="mt-3 font-display text-3xl sm:text-4xl text-[#1b2330]">Essential Traveler Information</h2>
        </div>

        <div class="grid gap-8 sm:grid-cols-3">
            <div class="card p-6 space-y-3">
                <div class="h-10 w-10 rounded-2xl bg-[#1b2330] text-[#f8f1e8] flex items-center justify-center font-bold">1</div>
                <h3 class="font-display text-xl font-bold text-[#1b2330]">Visa-Free Travel</h3>
                <p class="text-xs text-stone-600 leading-relaxed font-normal">
                    Citizens of over 80 countries (including EU, USA, Canada, UK, Australia, Singapore, and Japan) enter Kazakhstan visa-free for up to 30 continuous days.
                </p>
            </div>

            <div class="card p-6 space-y-3">
                <div class="h-10 w-10 rounded-2xl bg-[#d7b06a] text-[#171b1f] flex items-center justify-center font-bold">2</div>
                <h3 class="font-display text-xl font-bold text-[#1b2330]">Currency & Kaspi QR</h3>
                <p class="text-xs text-stone-600 leading-relaxed font-normal">
                    The national currency is the <strong>Kazakhstani Tenge (KZT)</strong>. Modern contactless payment is ubiquitous in cities; carry cash for remote yurt camps.
                </p>
            </div>

            <div class="card p-6 space-y-3">
                <div class="h-10 w-10 rounded-2xl bg-[#b98d52] text-white flex items-center justify-center font-bold">3</div>
                <h3 class="font-display text-xl font-bold text-[#1b2330]">Best Seasons</h3>
                <p class="text-xs text-stone-600 leading-relaxed font-normal">
                    <strong>Late Spring (May–June)</strong> brings wild tulips and alpine blossoms. <strong>Autumn (Sept–Oct)</strong> offers golden birch forests and mild canyon temperatures.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Interactive Kazakh Phrasebook Cards -->
<section class="py-20 bg-white border-b border-sky-100">
    <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-xl">
            <span class="badge-gold">✦ Kazakh Vocabulary ✦</span>
            <h2 class="mt-3 font-display text-3xl sm:text-4xl text-[#1b2330]">Useful Phrases for Your Trip</h2>
            <p class="mt-2 text-sm text-stone-600">Click a phrase card to reveal pronunciation and cultural usage tips.</p>
        </div>

        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var phrase in phrases)
            {
                <div class="rounded-3xl border border-[#eadfc9] p-6 cursor-pointer transition-all duration-200 @(selectedPhrase == phrase.Kazakh ? "ring-2 ring-[#d7b06a] bg-[#f8f3ec] shadow-md -translate-y-1" : "bg-white hover:border-[#d7b06a] hover:shadow-xs")"
                     @onclick="() => selectedPhrase = phrase.Kazakh">
                    <span class="text-[10px] font-bold uppercase tracking-wider text-stone-500">@phrase.Meaning</span>
                    <h3 class="mt-1 font-display text-2xl font-bold text-[#1b2330]">@phrase.Kazakh</h3>
                    <p class="text-xs font-mono text-[#1b2330] font-bold mt-1">[@phrase.Pronunciation]</p>
                    
                    @if (selectedPhrase == phrase.Kazakh)
                    {
                        <div class="mt-4 border-t border-[#eadfc9] pt-3 text-xs text-stone-600 leading-relaxed">
                            @phrase.Etiquette
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- Frequently Asked Questions Accordion -->
<section class="py-20 bg-paper">
    <div class="mx-auto max-w-4xl px-6">
        <div class="text-center mb-10">
            <span class="badge-azure">Common Questions</span>
            <h2 class="mt-3 font-display text-3xl sm:text-4xl text-sky-950">Traveler FAQ</h2>
        </div>

        <div class="space-y-3">
            @foreach (var faq in faqs)
            {
                <div class="overflow-hidden rounded-2xl border border-sky-100 bg-white shadow-xs transition-colors">
                    <button class="flex w-full items-center justify-between p-5 text-left font-display text-base font-semibold text-sky-950 hover:bg-sky-50/50"
                            @onclick="() => ToggleFaq(faq.Question)"
                            aria-expanded="@(openFaq == faq.Question)">
                        <span>@faq.Question</span>
                        <span class="ml-4 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-sky-50 border border-sky-200 text-sm text-sky-700 font-bold">
                            @(openFaq == faq.Question ? "−" : "+")
                        </span>
                    </button>
                    @if (openFaq == faq.Question)
                    {
                        <div class="border-t border-sky-100 p-5 text-xs text-stone-600 leading-relaxed bg-sky-50/30">
                            @faq.Answer
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string selectedPhrase = "Сәлеметсіз бе";
    private string? openFaq = "Is Kazakhstan safe for international travelers?";

    private record PhraseItem(string Kazakh, string Pronunciation, string Meaning, string Etiquette);
    private readonly List<PhraseItem> phrases = new()
    {
        new("Сәлеметсіз бе", "Sah-lem-et-siz beh", "Hello / Formal", "Used respectfully when addressing elders, yurt hosts, and hospitality staff."),
        new("Рахмет", "Rakh-met", "Thank you", "Warm expression of appreciation after being served hot tea or finishing a meal."),
        new("Қош келдіңіз!", "Qosh kel-ding-iz", "Welcome!", "The classic greeting extended when crossing the threshold into any yurt."),
        new("Ас дәмді болсын", "As dam-di bol-syn", "Bon appétit", "Steppe blessing spoken before partaking in the communal Dastarkhan banquet.")
    };

    private record FaqItem(string Question, string Answer);
    private readonly List<FaqItem> faqs = new()
    {
        new("Is Kazakhstan safe for international travelers?",
            "Yes, Kazakhstan is consistently recognized as one of the safest destinations in Eurasia. Violent crime is extremely low, and the cultural nomadic ethos views guest protection as a sacred responsibility."),
        new("What attire is customary at sacred shrines and mausoleums?",
            "When touring holy sites like Turkistan or underground mosques in Mangystau, modest clothing covering shoulders and knees is required. Women are advised to bring a light scarf for hair coverage."),
        new("How do travelers journey between remote regions?",
            "The country features modern high-speed Spanish 'Talgo' trains connecting major steppe hubs, daily domestic flights between Almaty and Astana, and rugged 4x4 expedition vehicles for national parks."),
        new("Are dietary accommodations easily available on expeditions?",
            "While Kazakh traditional cooking honors savory meats (Beshbarmak, Kazy), vegetarian and halal requests are happily accommodated with fresh flatbreads, honey, organic salads, and lentil stews.")
    };

    private void ToggleFaq(string q)
    {
        openFaq = (openFaq == q) ? null : q;
    }
}

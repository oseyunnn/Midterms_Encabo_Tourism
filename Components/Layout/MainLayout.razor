@inherits LayoutComponentBase

<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-accent focus:text-slate-950 focus:px-4 focus:py-2 focus:text-xs font-bold">
    Skip to main content
</a>

<NavMenu />

<main id="main">
    @Body
</main>

<footer class="mt-24 border-t border-sky-100 bg-[#f5f9fc] text-sky-900">
    <div class="mx-auto max-w-[1280px] px-6 py-10">
        <div class="grid gap-10 md:grid-cols-12">
            <div class="md:col-span-5 space-y-4">
                <div class="flex items-center gap-3">
                    <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#eef5fb] text-sky-700 shadow-sm">
                        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="11" r="3.5" /><path d="M12 3v2M12 17v2M4.5 11h2M17.5 11h2M6.7 5.7l1.4 1.4M15.9 14.9l1.4 1.4M6.7 16.3l1.4-1.4M15.9 7.1l1.4-1.4" stroke="#0d4f88" stroke-linecap="round" fill="none" /></svg>
                    </span>
                    <span class="font-display text-xl font-bold tracking-[0.18em] text-sky-900 uppercase">QAZAQ</span>
                </div>
                <p class="max-w-sm text-sm leading-relaxed text-sky-800/75">
                    Inviting travelers from around the globe to explore the golden steppes, turquoise alpine sanctuaries, and ancient Silk Road caravans of the Republic of Kazakhstan.
                </p>
                <div class="flex flex-wrap gap-2 pt-2 text-[11px]">
                    <span class="badge-glass text-sky-900 bg-white/80 border-sky-200">Republic of Kazakhstan</span>
                    <span class="badge-glass text-sky-900 bg-white/80 border-sky-200">UNESCO Silk Road</span>
                </div>
            </div>

            <div class="md:col-span-3">
                <h3 class="text-[11px] font-bold uppercase tracking-[0.22em] text-sky-700">Explore</h3>
                <ul class="mt-4 space-y-2.5 text-sm text-sky-800/80">
                    <li><a href="/" class="hover:text-sky-900">Home</a></li>
                    <li><a href="/about" class="hover:text-sky-900">About</a></li>
                    <li><a href="/spots" class="hover:text-sky-900">Destinations</a></li>
                    <li><a href="/reviews" class="hover:text-sky-900">Reviews</a></li>
                </ul>
            </div>

            <div class="md:col-span-4">
                <h3 class="text-[11px] font-bold uppercase tracking-[0.22em] text-sky-700">Almaty Visitor Liaison</h3>
                <p class="mt-4 text-sm leading-relaxed text-sky-800/75">
                    Dostyk Avenue 180, Almaty, Kazakhstan.<br />
                    Travel Assistance: <strong class="text-sky-900">+7 (727) 355-QAZAQ</strong><br />
                    paradise@qazaq-tourism.kz
                </p>
            </div>
        </div>

        <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-sky-200 pt-6 text-[11px] text-sky-700 sm:flex-row">
            <p>&copy; @DateTime.Now.Year QAZAQ Expeditions. Inspired by Kazakhstan's Sun & Sky.</p>
            <p class="font-serif italic text-sky-800">"Қош келдіңіздер — Welcome to Our Steppe Paradise"</p>
        </div>
    </div>
</footer>

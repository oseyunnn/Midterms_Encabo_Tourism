@rendermode InteractiveServer

<header class="sticky top-0 z-50 border-b border-sky-100/80 bg-[#f4f8fb]/80 backdrop-blur-xl transition-all shadow-[0_12px_30px_rgba(23,49,77,0.04)]">
    <nav class="mx-auto flex max-w-[1280px] items-center justify-between px-6 py-4" aria-label="Main Navigation">
        <NavLink href="/" class="flex items-center gap-3.5 group">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#f7f3ed] text-sky-700 shadow-[0_12px_25px_rgba(22,54,79,0.08)] transition-transform duration-300 group-hover:scale-105">
                <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="11" r="3.5" />
                    <path d="M12 3v2M12 17v2M4.5 11h2M17.5 11h2M6.7 5.7l1.4 1.4M15.9 14.9l1.4 1.4M6.7 16.3l1.4-1.4M15.9 7.1l1.4-1.4" stroke="#0d4f88" stroke-width="1.6" stroke-linecap="round" fill="none" />
                    <path d="M6 18c3-2 6-1 6-1s3-1 6 1c-2-3-6-3-6-3s-4 0-6 3z" fill="#d5a76d" />
                </svg>
            </span>
            <div class="leading-none">
                <span class="block font-display text-[26px] font-bold tracking-[0.14em] text-sky-900 uppercase">QAZAQ</span>
            </div>
        </NavLink>

        <ul id="nav-links-desktop" class="hidden items-center gap-9 md:flex">
            <li><NavLink href="/" Match="NavLinkMatch.All" class="tiny-nav">Home</NavLink></li>
            <li><NavLink href="/about" class="tiny-nav">About</NavLink></li>
            <li><NavLink href="/spots" class="tiny-nav">Destinations</NavLink></li>
            <li><NavLink href="/reviews" class="tiny-nav">Reviews</NavLink></li>
        </ul>

        <div class="hidden items-center gap-4 md:flex">
            <NavLink href="/spots" class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-sky-100 bg-white text-sky-700 shadow-sm hover:bg-sky-50" aria-label="Search destinations">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="6" /><path d="m16 16 4 4" /></svg>
            </NavLink>
            <NavLink href="/booking" class="btn-gold text-[10px] py-2.5 px-5">
                Book Our Paradise
            </NavLink>
        </div>

        <button class="flex h-10 w-10 items-center justify-center rounded-full border border-sky-100 bg-white text-sky-800 shadow-sm md:hidden"
                @onclick="() => open = !open"
                aria-expanded="@open" aria-controls="nav-links-mobile" aria-label="Toggle navigation">
            @if (open)
            {
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" /></svg>
            }
            else
            {
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            }
        </button>

        <div id="nav-links-mobile" class="@(open ? "flex" : "hidden") md:hidden absolute left-0 right-0 top-full flex-col gap-2 border-b border-sky-100 bg-[#f4f8fb]/95 px-6 py-6 shadow-2xl backdrop-blur-xl">
            <NavLink href="/" Match="NavLinkMatch.All" class="rounded-xl px-4 py-2 text-sm font-bold uppercase tracking-[0.18em] text-sky-800 hover:bg-white" @onclick="Close">Home</NavLink>
            <NavLink href="/about" class="rounded-xl px-4 py-2 text-sm font-bold uppercase tracking-[0.18em] text-sky-800 hover:bg-white" @onclick="Close">About</NavLink>
            <NavLink href="/spots" class="rounded-xl px-4 py-2 text-sm font-bold uppercase tracking-[0.18em] text-sky-800 hover:bg-white" @onclick="Close">Destinations</NavLink>
            <NavLink href="/reviews" class="rounded-xl px-4 py-2 text-sm font-bold uppercase tracking-[0.18em] text-sky-800 hover:bg-white" @onclick="Close">Reviews</NavLink>
            <div class="mt-2 border-t border-sky-100 pt-2">
                <NavLink href="/booking" class="btn-gold w-full justify-center text-[10px]" @onclick="Close">Book Our Paradise</NavLink>
            </div>
        </div>
    </nav>
</header>

@code {
    private bool open;
    private void Close() => open = false;
}
